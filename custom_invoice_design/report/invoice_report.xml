<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper format: A4 Portrait with small margins.
             margin_bottom is 30 (not 6) because the repeated page footer now
             carries the certificates strip on top of the company name / page
             counter: the footer is drawn inside the bottom margin by
             wkhtmltopdf, so the margin has to be at least as tall as the
             footer content (~27mm) instead of overlapping the invoice body. -->
        <record id="paperformat_custom_invoice" model="report.paperformat">
            <field name="name">Custom Invoice A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">6</field>
            <field name="margin_bottom">30</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <!-- Custom Invoice Report Action bound to account.move (all move types:
             customer invoices/credit notes AND vendor bills/credit notes) -->
        <record id="action_report_custom_invoice" model="ir.actions.report">
            <field name="name">Print INV / Bill</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_invoice_design.invoice_report_template</field>
            <field name="report_file">custom_invoice_design.invoice_report_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_custom_invoice"/>
            <!-- Vendor bills / vendor credit notes download as "Bill - ...",
                 customer documents keep the historical name. -->
            <field name="print_report_name">('Bill - %s' % (object.name or 'Draft')) if object.move_type in ('in_invoice', 'in_refund') else ('Tax Invoice - %s' % (object.name or 'Draft'))</field>
        </record>
    </data>
</odoo>
